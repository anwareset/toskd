# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store
.pnpm-debug.log*

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Vercel
.vercel/

# OS files
.DS_Store
Thumbs.db
.vercel
.env*
# .env.example di-track sebagai referensi (contoh file env). Negasi harus
# berada SETELAH pattern `.env*` di atas (semantik gitignore: pattern
# terakhir yang match menang).
!.env.example

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.local

# Specs
specs/**
*-spec.md

# Tests-debug related
tests/*.txt
tests/*.json
tests/trace-*.mjs
tests/migration-*.mjs
apply*.mjs

# Supabase — commit hanya sumber (config + migrations); cache/artefak lokal tetap di-ignore
supabase/*
!supabase/config.toml
!supabase/migrations/
!supabase/seed.sql
!supabase/.gitignore
supabase/.temp/
supabase/.branches/
supabase/snippets/

# Supabase DB backups (supabase db dump)
backup-*.sql

# Graphify — graph artifacts are TRACKED (graphify-out/), only local-only/non-deterministic files ignored
# cost.json: local-only token cost tracker (per Graphify README); cache/ optional utk kecepatan (default skip)
# .graphify_root: path absolut lokal (scan root), dibuat ulang otomatis saat extract — tidak portabel utk commit
# .graphify_python: path interpreter lokal (dibuat skill), tidak portabel utk commit
# manifest.json: berisi timestamp 'seen' yang berubah tiap run → commit churn di CI; dibuat ulang otomatis (CI selalu --force)
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/manifest.json
