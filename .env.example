# === Bootstrap (TEMPORARY — delete from Vercel after first successful deploy) ===
# Used on first cold-start to seed the first admin row.
# After admin row exists in `admins` table, DELETE these env vars
# from Vercel dashboard to avoid plaintext password leak.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
NODE_ENV=production
# Generate via: openssl rand -hex 32
# Must be >= 32 chars. Used to sign JWT session cookies.
JWT_SECRET=replace-with-strong-random-64-char-hex-string

# Supabase
SUPABASE_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9XXX

# Vercel
BLOB_STORE_ID=store_XzXXXXX
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxx
VERCEL_CLI_DISABLE_TELEMETRY=1

# Created by Vercel CLI
VERCEL_OIDC_TOKEN="eyJXXX"

# Etc
TZ=Asia/Jakarta
COOKIE_SECURE=true
