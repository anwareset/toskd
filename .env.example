# === Bootstrap User Admin  ===
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
NODE_ENV=production
# Generate JWT_SECRET via: openssl rand -hex 32. Must be >= 32 chars. Used to sign JWT session cookies.
JWT_SECRET=replace-with-strong-random-64-char-hex-string

# Supabase
SUPABASE_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9XXX

# Vercel
BLOB_STORE_ID=store_XzXXXXX
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxx
VERCEL_CLI_DISABLE_TELEMETRY=1

# Created by Vercel CLI
VERCEL_OIDC_TOKEN="eyJXXX"

# Etc
TZ=Asia/Jakarta
COOKIE_SECURE=true

# === Observability: OpenTelemetry + Pino (optional) ===
# Telemetry AKTIF hanya jika OTEL_SERVICE_NAME DAN OTEL_EXPORTER_OTLP_ENDPOINT keduanya terisi.
# OTEL_SERVICE_NAME=toskd
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_METRICS_EXPORTER=otlp   # Metrics: otlp|console|none (default otlp)
# OTEL_TRACES_EXPORTER=otlp    # Traces: otlp|zipkin|console|none
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_TRACE_SAMPLE_RATIO=0.1
LOG_LEVEL=debug
